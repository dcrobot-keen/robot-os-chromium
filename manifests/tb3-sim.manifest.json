{
  "robot": "tb3-sim-01",
  "base": "roboteq-sim-2d",
  "transport": { "kind": "roboteq-serial", "url": "ws://127.0.0.1:8765" },
  "drive": {
    "kind": "differential",
    "channels": { "left": 1, "right": 2 },
    "scale": 1000,
    "commands": {
      "init": ["^ECHOF 1", "!R 2", "!AC 1 6000_!AC 2 6000", "!DC 1 6000_!DC 2 6000"],
      "enable": "!MG",
      "estop": "!EX",
      "setVelocity": "!G ${ch.left} ${v.left}_!G ${ch.right} ${v.right}"
    },
    "geometry": { "wheelRadius": 0.033, "wheelSeparation": 0.16, "countsPerRev": 4096, "maxWheelRpm": 63.7 },
    "readback": {
      "encoder": "?C",
      "battery": "?V 2",
      "current": "?A",
      "temperature": "?T 1",
      "faultFlags": "?FF",
      "estopButton": "?DI"
    }
  }
}
