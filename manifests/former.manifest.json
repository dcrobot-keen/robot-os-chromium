{
  "robot": "former-01",
  "base": "roboteq",
  "transport": { "kind": "roboteq-serial", "baud": 115200, "device": "/dev/ttyMOTOR" },
  "drive": {
    "kind": "differential",
    "channels": { "left": 1, "right": 2 },
    "scale": 1000,
    "commands": {
      "init": ["^ECHOF 1", "!R 2", "!AC 1 6000_!AC 2 6000", "!DC 1 6000_!DC 2 6000"],
      "enable": "!MG",
      "estop": "!EX",
      "setVelocity": "!G ${ch.left} ${v.left}_!G ${ch.right} ${v.right}"
    },
    "geometry": { "wheelRadius": 0.085, "wheelSeparation": 0.305, "countsPerRev": 16384, "maxWheelRpm": 200 },
    "readback": {
      "encoder": "?C",
      "battery": "?V 2",
      "current": "?A",
      "temperature": "?T 1",
      "faultFlags": "?FF",
      "estopButton": "?DI"
    }
  }
}
