# Former 2.0 serial device names — copied from ROAS former_bringup
# (former_bringup/scripts/99-former-devices.rules). The Former has two
# FTDI FT232 adapters with the SAME 0403:6001 id, told apart only by their
# fixed USB devpath (4.2 = motor controller, 4.1 = the GPIO/sonar board).
# If former_bringup is installed, use ITS rules instead of this file.
# The devpath values are specific to the Former's internal USB wiring; if
# /dev/ttyMOTOR doesn't appear, check `udevadm info -a -n /dev/ttyUSB0`.

KERNEL=="ttyUSB[0-9]*", MODE="0666", TAG+="systemd", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{devpath}=="4.2", SYMLINK+="ttyMOTOR", RUN+="/bin/setserial /dev/%k low_latency"
KERNEL=="ttyUSB[0-9]*", MODE="0666", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{devpath}=="4.1", SYMLINK+="ttyARDUINO", RUN+="/bin/setserial /dev/%k low_latency"
KERNEL=="ttyUSB[0-9]*", MODE="0666", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", SYMLINK+="ttyIMU"
